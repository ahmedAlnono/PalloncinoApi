    <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>573a5567-a646-45a3-9cc1-f2b4b03f4683</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
